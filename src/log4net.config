<log4net>
	<!-- Configure root logger -->
	<root>
		<level value="ALL" />
		<appender-ref ref="ConsoleAppender" />
		<appender-ref ref="DiagnosticsHttpAppender" />
	</root>

	<!-- Console is the only appender for local visibility -->
	<appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%utcdate{yyyy-MM-ddTHH:mm:ss.fff}Z %-5level runId=%property{runId} docType=%property{docType} project=%property{project} - %logger : %message%newline" />
		</layout>
	</appender>

	<!-- HTTP appender: relays warn/error to api-gate's diagnostics store, and info/debug only for a run
	     that asked for extra capture (see DiagnosticsHttpAppender.ShouldPersist). The threshold keeps
	     debug out entirely. No-ops silently when DIAGNOSTICS_INGEST_URL / DIAGNOSTICS_INGEST_TOKEN are unset. -->
	<appender name="DiagnosticsHttpAppender" type="JsonToWord.Logging.DiagnosticsHttpAppender, JsonToWord">
		<threshold value="INFO" />
	</appender>
</log4net>
